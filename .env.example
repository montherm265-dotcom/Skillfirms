VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Error monitoring (Sentry) and product analytics (PostHog, EU region).
# Both of these are public, client-embeddable identifiers by design (a
# Sentry DSN only lets a client submit events; a PostHog project API key
# is meant to ship in a browser bundle) -- not secrets, but still optional:
# the app runs fine with either or both unset, it just won't report.
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
